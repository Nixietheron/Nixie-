# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App and signed wallet session
NEXT_PUBLIC_APP_URL=https://your-app.example
AUTH_SECRET=replace_with_a_long_random_secret
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Robinhood Mainnet — set these to the official production network values.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# Required for on-chain token verification. Use Robinhood's official Mainnet RPC URL.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Museum gate. `ROBINHOOD_MIN_TOKEN_AMOUNT` is a human-readable amount, not wei.
ROBINHOOD_TOKEN_ADDRESS=0x41b24bb02b0884b3b696f1a4e7c4bc3d4a31fc8f
ROBINHOOD_TOKEN_DECIMALS=18
ROBINHOOD_MIN_TOKEN_AMOUNT=500000
ROBINHOOD_NFT_ADDRESS=0xYourNixieNftAddress
# Set true only before launch. Keep false once a token/NFT contract is configured.
MUSEUM_PREVIEW_MODE=false

# Telegram NIX buy alerts. Create the bot with @BotFather, add it to the target
# group/channel as an admin, then use that chat's numeric ID (for example -100...).
# A "buy" is a NIX Transfer whose sender is one of these verified DEX pool addresses.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=replace_with_a_long_random_secret
NIX_BUY_POOL_ADDRESSES=0xYourVerifiedNixDexPoolAddress
NIX_BUY_CONFIRMATIONS=3
NIX_BUY_MIN_AMOUNT=0
NIX_BUY_MAX_BLOCK_RANGE=500
# Maximum block span per eth_getLogs call. Keep 10 for Alchemy Free.
NIX_BUY_LOG_BLOCK_RANGE=10
NIX_TOKEN_SYMBOL=NIX
# Optional: defaults to ${NEXT_PUBLIC_APP_URL}/nix-buy-alert.png.
NIX_BUY_ALERT_IMAGE_URL=

# Admin and Pinata uploads
ADMIN_EMAIL=admin@example.com
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
# PINATA_GATEWAY_TOKEN=
